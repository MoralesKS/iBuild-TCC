{
  "expo": {
    "name": "iBuild",
    "slug": "iBuild",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoIbuild.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Slapsh.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ios",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logoIbuild.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.morales_ks.iBuild"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "55e42e48-2590-487b-ab1a-d805b63cb864"
      }
    }
  }
}
